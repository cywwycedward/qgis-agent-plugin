root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# A trailing double space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
# cmd.exe misreads a batch file that is not CRLF, and mangles non-ASCII bytes
# it did not expect; TEST.md records both. Keep batch files plain.
charset = ascii
end_of_line = crlf
